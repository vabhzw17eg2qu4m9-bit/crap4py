#!/usr/bin/env bash
# Pre-commit: run crap4py (threshold 8.0) on staged .py files. Any nonzero
# exit refuses the commit — exit 2 is a threshold breach, anything else
# means the check could not run.
set -eu

cd "$(git rev-parse --show-toplevel)"

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -z "$files" ]; then
  exit 0
fi

# Prefer python3: modern macOS and most Linux distributions ship no bare
# `python`, so guarding on that name alone skipped the check entirely
# whenever a virtualenv was not active.
py=""
for candidate in python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 &&
    "$candidate" -m crap4py --help >/dev/null 2>&1; then
    py="$candidate"
    break
  fi
done

if [ -z "$py" ]; then
  echo "warning: crap4py not available; skipping CRAP pre-commit check." >&2
  exit 0
fi

# `set -e` aborts the script on a failing command substitution, so the tool's
# exit status has to be captured with `set +e`. Without it the shell exited
# here and the report plus the reason below were never printed. Every nonzero
# status still refuses the commit: a usage or I/O error (exit 1) means the
# check did not run, which must not read as approval.
set +e
# shellcheck disable=SC2086
report=$("$py" -m crap4py --threshold 8.0 --coverage coverage.json $files 2>&1)
code=$?
set -e

if [ "$code" -ne 0 ]; then
  echo "$report" >&2
  if [ "$code" -eq 2 ]; then
    echo "Commit blocked: CRAP threshold exceeded (see report above)." >&2
  else
    echo "Commit blocked: crap4py exited $code (see output above)." >&2
  fi
  exit 1
fi

exit 0
