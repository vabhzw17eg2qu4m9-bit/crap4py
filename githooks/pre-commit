#!/usr/bin/env bash
# Pre-commit: run crap4py (threshold 8.0) on staged .py files; block on exit 2.
set -eu

cd "$(git rev-parse --show-toplevel)"

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -z "$files" ]; then
  exit 0
fi

if ! command -v python >/dev/null 2>&1 || ! python -m crap4py --help >/dev/null 2>&1; then
  echo "warning: crap4py not available; skipping CRAP pre-commit check." >&2
  exit 0
fi

# shellcheck disable=SC2086
report=$(python -m crap4py --threshold 8.0 --coverage coverage.json $files 2>&1)
code=$?

if [ "$code" -eq 2 ]; then
  echo "$report" >&2
  echo "Commit blocked: CRAP threshold exceeded (see report above)." >&2
  exit 1
fi

exit 0
